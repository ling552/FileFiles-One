// 双面板视图的右侧独立文件面板：与左侧共享布局（网格 / 列表，由 AppState.view-mode 决定）。
// 读写 AppState 的 r-* 状态，与左侧（活动标签）完全独立。
// 指针交互（点击/双击/右键/空白框选/跨面板拖拽/Ctrl+滚轮缩放）由 InputOverlay 统一处理。
import { Theme } from "theme.slint";
import { AppState, FileEntry } from "globals.slint";
import { FileIcon } from "file_icon.slint";
import { InputOverlay } from "input_overlay.slint";
import { RenameEdit } from "rename_edit.slint";
import { ListView } from "std-widgets.slint";

// 右面板列表视图（支持框选多选，绑定 r-entries）
component RightList inherits Rectangle {
    callback request-context-menu(int, length, length);
    property <length> scaled-row-h: Theme.row-h * AppState.icon-scale;
    property <length> icon-box: 18px * AppState.icon-scale;

    // 滚动重置：右面板导航新目录时归零 viewport-y
    property <int> scroll-token: AppState.r-scroll-top-token;
    changed scroll-token => { list.viewport-y = 0px; }

    list := ListView {
        width: 100%;
        height: 100%;
        for entry[i] in AppState.r-entries: row := Rectangle {
            height: root.scaled-row-h;
            // 选中/悬停随主题色联动，奇偶条纹与左面板 FileList 一致
            background: entry.selected
                ? Theme.selection-bg
                : (ov.hover-idx == i ? Theme.primary-hover
                    : (mod(i, 2) == 1 ? Theme.row-stripe : transparent));
            // 默认 stretch 布局（勿加 alignment: start——非 stretch 对齐下
            // 名称区包裹 Rectangle 的首选宽为 0，文件名会整体塌缩不可见）：
            // 图标与日期取首选宽，名称区经 horizontal-stretch: 1 占满剩余空间
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;

                FileIcon {
                    icon-class: entry.icon-class;
                    label: entry.icon-label;
                    thumb: entry.thumb;
                    has-thumb: entry.has-thumb;
                    compact: true;
                    box: root.icon-box;
                    y: (parent.height - root.icon-box) / 2;
                }
                // 名称区：正常显示文本，进入行内重命名（r-editing-index 命中）时换成输入框
                Rectangle {
                    horizontal-stretch: 1;
                    if AppState.r-editing-index != i: cell-name-text := Text {
                        width: 100%;
                        height: 100%;
                        text: entry.name;
                        font-size: Theme.fs-small;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if AppState.r-editing-index == i: RenameEdit {
                        width: 100%;
                        y: (parent.height - self.height) / 2;
                        multiline: false;   // 列表模式保持单行
                        text: entry.name;
                        font-size: Theme.fs-small;
                        // 文本变化时保存到全局
                        text-changed(t) => { AppState.r-rename-text = t; }
                        // 按 Escape 退出重命名
                        cancel => { AppState.r-editing-index = -1; }
                        commit(t) => {
                            AppState.r-rename-entry(i, t);
                            AppState.r-editing-index = -1;
                        }
                    }
                }
                Text {
                    text: entry.is-dir ? entry.modified : entry.size;
                    font-size: Theme.fs-tiny;
                    color: Theme.subtle;
                    vertical-alignment: center;
                }
            }
        }
    }
    ov := InputOverlay {
        width: 100%;
        height: 100%;
        pane: "right";
        mode: "list";
        count: AppState.r-entries.length;
        cols: 1;
        row-h: root.scaled-row-h;
        left-pad: 12px;
        vp-y <=> list.viewport-y;
        vp-h: list.viewport-height;
        vis-h: list.visible-height;
        request-context-menu(i, mx, my) => { root.request-context-menu(i, mx, my); }
    }
}

// 右面板网格视图（按行虚拟化，绑定 r-entries），与 FileGrid 视觉一致
component RightGrid inherits Rectangle {
    callback request-context-menu(int, length, length);
    clip: true;
    property <length> cell-w: 112px * AppState.icon-scale;
    property <length> icon-box: 58px * AppState.icon-scale;
    property <length> icon-top: 12px;
    property <length> name-gap: 0px;
    property <length> info-h: 16px;
    // 未选中项最多显示两行；选中项按完整文本高度展开。
    property <length> name-h: 32px;
    property <length> cell-h: max(root.cell-w, root.icon-top + root.icon-box + root.name-gap + root.name-h + root.info-h + 10px);
    property <length> pitch: root.cell-w + 10px;
    property <length> row-h: root.cell-h + 10px;
    property <int> cols: max(1, floor((list.visible-width - 24px) / root.pitch));
    property <int> rows: ceil(AppState.r-entries.length / max(1, root.cols));

    // 滚动重置：右面板导航新目录时归零 viewport-y
    property <int> scroll-token: AppState.r-scroll-top-token;
    changed scroll-token => { list.viewport-y = 0px; }

    list := ListView {
        width: 100%;
        height: 100%;
        for r in root.rows: Rectangle {
            height: root.row-h;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: r == 0 ? 12px : 0px;
                spacing: 10px;
                alignment: start;

                for col in root.cols: cell := Rectangle {
                    property <int> idx: r * root.cols + col;
                    property <bool> valid: self.idx < AppState.r-entries.length;
                    width: root.cell-w;
                    height: root.cell-h;

                    if cell.valid: card := Rectangle {
                        property <FileEntry> entry: AppState.r-entries[cell.idx];
                        // 长名称展示改由顶层覆盖层处理，避免遮住下一行。
                        property <length> extra-name-h: 0px;
                        border-radius: Theme.radius-card;
                        border-width: 1px;
                        border-color: card.entry.selected ? Theme.selection-border : transparent;
                        background: card.entry.selected
                            ? Theme.selection-bg
                            : (ov.hover-idx == cell.idx ? Theme.primary-hover : transparent);
                        // 选中状态（含编辑中）由顶层完整卡片绘制，确保长名称始终在下一行项目之上。
                        visible: !card.entry.selected;
                        drop-shadow-blur: card.entry.selected ? Theme.selection-shadow-blur : 0px;
                        drop-shadow-color: card.entry.selected ? Theme.selection-shadow : transparent;
                        drop-shadow-offset-y: card.entry.selected ? 2px : 0px;
                        // 卡片固定贴住单元格上边缘。
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: root.cell-h + card.extra-name-h;
                        clip: true;

                        // 直接定位图标、名称和信息行，避免布局在名称高度变化时重新居中。
                        FileIcon {
                            x: (parent.width - root.icon-box) / 2;
                            y: root.icon-top;
                            icon-class: card.entry.icon-class;
                            label: card.entry.icon-label;
                            thumb: card.entry.thumb;
                            has-thumb: card.entry.has-thumb;
                            box: root.icon-box;
                        }
                        if AppState.r-editing-index != cell.idx: name-area := Rectangle {
                            x: 8px;
                            y: root.icon-top + root.icon-box + root.name-gap;
                            width: parent.width - 16px;
                            // 基础卡片始终只显示两行名称；选中后的完整名称由顶层覆盖层绘制。
                            height: root.name-h;
                            clip: true;
                            cell-name-text := Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: self.preferred-height;
                                text: card.entry.name;
                                font-size: Theme.fs-small;
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: top;
                                // 文件名换行：用 word-wrap 而非 char-wrap。
                                // char-wrap 在 femtovg 渲染器下对 CJK 字符处理异常
                                // （CJK 字符消失、仅残留 ASCII 尾部，如「hey小可爱.txt」显示成「xt」）。
                                // word-wrap 走 unicode-linebreak（UAX 14），CJK 字符间天然为断行点，
                                // 行为等价于逐字换行且对所有渲染器稳定。
                                wrap: word-wrap;
                                overflow: clip;
                            }
                        }
                        // 重命名输入框不再在基础卡内渲染：长名会被卡片 clip 截断。
                        // 改由顶层覆盖层（下方 for entry[i] editing-card）按文本宽度伸长绘制。
                        Text {
                            x: 8px;
                            y: root.icon-top + root.icon-box + root.name-gap + root.name-h + card.extra-name-h;
                            width: parent.width - 16px;
                            text: card.entry.is-dir ? card.entry.modified : card.entry.size;
                            font-size: Theme.fs-tiny;
                            color: Theme.subtle;
                            height: root.info-h;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // 选中项目作为完整不透明卡片绘制在列表上层，完整名称覆盖下一行。
    for entry[i] in AppState.r-entries: selected-card := Rectangle {
        property <bool> visible-card: entry.selected;
        property <int> grid-row: floor(i / root.cols);
        property <int> grid-col: mod(i, root.cols);
        property <length> content-y: (self.grid-row == 0 ? 12px : self.grid-row * root.row-h) + list.viewport-y;
        visible: self.visible-card;
        x: 12px + self.grid-col * root.pitch;
        y: self.content-y;
        width: root.cell-w;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.selection-border;
        background: Theme.selection-bg;
        clip: true;
        drop-shadow-blur: Theme.selection-shadow-blur;
        drop-shadow-color: Theme.selection-shadow;
        drop-shadow-offset-y: 2px;

        FileIcon {
            x: (parent.width - root.icon-box) / 2;
            y: root.icon-top;
            icon-class: entry.icon-class;
            label: entry.icon-label;
            thumb: entry.thumb;
            has-thumb: entry.has-thumb;
            box: root.icon-box;
        }
        selected-name-text := Text {
            visible: AppState.r-editing-index != i;
            x: 8px;
            y: root.icon-top + root.icon-box + root.name-gap;
            width: parent.width - 16px;
            height: self.preferred-height;
            text: entry.name;
            font-size: Theme.fs-small;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
            overflow: clip;
        }
        // 信息行固定在默认名称区下方；仅超出两行的实际名称才会把它向下推。
        property <length> extra-name-h: max(0px, selected-name-text.preferred-height - root.name-h);
        Text {
            x: 8px;
            y: root.icon-top + root.icon-box + root.name-gap + root.name-h + selected-card.extra-name-h;
            width: parent.width - 16px;
            text: entry.is-dir ? entry.modified : entry.size;
            font-size: Theme.fs-tiny;
            color: Theme.subtle;
            height: root.info-h;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        height: root.cell-h + self.extra-name-h;
    }

    // 重命名覆盖层：r-editing-index 命中时，在对应的右面板卡片名区位置绘制可伸长输入框。
    // 独立于 ListView 虚拟化与卡片 clip，长名按名区宽度换行后向下伸长，完整可见；
    // 超出可视区由 RightGrid 的 clip 裁剪。
    for entry[i] in AppState.r-entries: editing-card := Rectangle {
        property <int> grid-row: floor(i / root.cols);
        property <int> grid-col: mod(i, root.cols);
        property <length> content-y: (self.grid-row == 0 ? 12px : self.grid-row * root.row-h) + list.viewport-y;
        // 与基础卡片名区逐像素对齐（卡片左缘 + 8px 内缩，宽度 cell-w - 16px），
        // 使编辑态的换行位置与正常显示完全一致，每行字符数相同。
        x: 12px + self.grid-col * root.pitch + 8px;
        y: self.content-y + root.icon-top + root.icon-box + root.name-gap;
        width: root.cell-w - 16px;
        // 定位容器本身不绘制，高度取 0；输入框按文本高度自行向下伸长（无 clip，正常可见）。
        height: 0px;
        // 必须用条件实例化而非 visible 复用实例：复用时退出编辑会多渲染一帧
        // 「非编辑外观」（透明底 + 普通文字色叠在选中底色上），表现为洗白的中间态。
        if AppState.r-editing-index == i: RenameEdit {
            x: 0px;
            y: 0px;
            width: parent.width;
            multiline: true;   // 网格模式允许按名称区宽度换行
            text: entry.name;
            font-size: Theme.fs-small;
            text-changed(t) => { AppState.r-rename-text = t; }
            cancel => { AppState.r-editing-index = -1; }
            commit(t) => {
                AppState.r-rename-entry(i, t);
                AppState.r-editing-index = -1;
            }
        }
    }

    ov := InputOverlay {
        width: 100%;
        height: 100%;
        pane: "right";
        mode: "grid";
        count: AppState.r-entries.length;
        cols: root.cols;
        row-h: root.row-h;
        cell-w: root.cell-w;
        pitch-x: root.pitch;
        top-pad: 12px;
        left-pad: 12px;
        vp-y <=> list.viewport-y;
        vp-h: list.viewport-height;
        vis-h: list.visible-height;
        request-context-menu(i, mx, my) => { root.request-context-menu(i, mx, my); }
    }
}

export component RightPane inherits Rectangle {
    callback request-context-menu(int, length, length);
    // 内容区：与左侧共享 view-mode 决定网格 / 列表。
    // 导航由公用工具栏统一驱动，此处不再携带独立头部。
    // 注意：此 6px 与 dual_pane.slint 右面板菜单坐标偏移（+16px = 6+8+2）联动
    VerticalLayout {
        padding: 6px;
        Rectangle {
            vertical-stretch: 1;
            if AppState.view-mode == "grid": RightGrid {
                request-context-menu(i, mx, my) => { root.request-context-menu(i, mx, my); }
            }
            if AppState.view-mode != "grid": RightList {
                request-context-menu(i, mx, my) => { root.request-context-menu(i, mx, my); }
            }
        }
    }
}
