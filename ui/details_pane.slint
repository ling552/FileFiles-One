import { Theme } from "theme.slint";
import { AppState } from "globals.slint";
import { FileIcon } from "file_icon.slint";
import { ScrollView } from "std-widgets.slint";

component info-row inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 10px;
    Text {
        text: label;
        width: 74px;
        font-size: Theme.fs-small;
        color: Theme.subtle;
        vertical-alignment: top;
    }
    Text {
        text: value;
        min-width: 0px;
        font-size: Theme.fs-small;
        color: Theme.text;
        wrap: word-wrap;
        horizontal-stretch: 1;
        vertical-alignment: top;
    }
}

// 右侧详情/预览面板，对照 design_ref 的 .details-pane
export component DetailsPane inherits Rectangle {
    width: Theme.details-w;
    background: Theme.surface-2.with-alpha(Theme.panel-alpha);
    border-radius: Theme.radius-card;
    clip: true;

    // 不再手动设 viewport-height: self.visible-height——它会把 viewport 锁定成
    // 可视高度，内容（长文件名换行 / 多字段）超出时无法滚动并把字段压挤截断。
    // 让 ScrollView 按内容自动计算 viewport 高度，超出可视区即可垂直滚动，
    // 内部 padding-bottom 也能正确露出，保证末行与底部留有间距。
    ScrollView {
        VerticalLayout {
            padding: 16px;
            padding-bottom: 24px;
            spacing: 14px;
            alignment: start;

            if !AppState.has-selection: VerticalLayout {
                padding-top: 40px;
                spacing: 10px;
                HorizontalLayout {
                    alignment: center;
                    // 矢量绘制的文档轮廓图标，避免依赖字体里可能缺失的符号字形
                    Path {
                        width: 52px;
                        height: 52px;
                        fill: Theme.subtle;
                        fill-rule: evenodd;
                        commands: "M14 2 H6 C4.9 2 4 2.9 4 4 V20 C4 21.1 4.9 22 6 22 H18 C19.1 22 20 21.1 20 20 V8 L14 2 Z M14 2 V8 H20 M8 13 H16 M8 16 H16 M8 19 H13";
                    }
                }
                Text {
                    text: "未选择项目";
                    font-size: 15px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                }
                Text {
                    text: "选中文件后可预览属性, 标签与哈希摘要";
                    font-size: Theme.fs-small;
                    color: Theme.subtle;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            if AppState.has-selection: card := Rectangle {
                // 高度严格跟随内部内容：Rectangle 自身 preferred-size 为 0x0，
                // 不会把子 layout 的内容高度向上透传给 ScrollView 的 viewport，
                // 导致 viewport 被锁定在可视高度、超出部分被 clip 裁掉（长文件名
                // 换行 / 多字段时底部「属性/标签」被切掉）。用 min-height 绑定内部
                // layout 的 preferred-height，卡片才能在 ScrollView 中撑到内容全高，
                // 超出可视区时正确滚动、末行间距也得以露出。
                min-height: card-content.preferred-height;
                border-radius: 14px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                clip: true;
                card-content := VerticalLayout {
                    // 预览视觉块：有缩略图时直接渲染位图，否则渲染对应矢量图标。
                    // 高度自适应：有真实缩略图沿用 150px；纯矢量图标用 120px，
                    // 与下方信息区比例更协调，长文件名换行时不至于把字段挤满。
                    Rectangle {
                        height: AppState.sel-has-thumb ? 150px : 120px;
                        background: AppState.sel-has-thumb
                            ? Theme.surface-2
                            : @linear-gradient(135deg, #0a84ff 0%, #5ac8fa 100%);
                        FileIcon {
                            icon-class: AppState.sel-icon-class;
                            thumb: AppState.sel-thumb;
                            has-thumb: AppState.sel-has-thumb;
                            box: 96px;
                            radius: 16px;
                        }
                    }
                    VerticalLayout {
                        padding: 14px;
                        padding-bottom: 20px;
                        spacing: 4px;
                        Text {
                            text: AppState.sel-name;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        Text {
                            text: AppState.sel-kind;
                            font-size: Theme.fs-small;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        // 信息列表
                        VerticalLayout {
                            padding-top: 10px;
                            spacing: 10px;
                            info-row { label: "位置"; value: AppState.sel-location; }
                            // 大小：文件直接显示；文件夹默认显示「计算」按钮，
                            // 点击后台递归统计总大小（含所有子文件），完成后回填此处
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "大小";
                                    width: 74px;
                                    font-size: Theme.fs-small;
                                    color: Theme.subtle;
                                    vertical-alignment: top;
                                }
                                // 已计算完成（sel-size 非占位「—」）：直接显示结果
                                if !AppState.sel-is-dir || AppState.sel-size != "—": Text {
                                    text: AppState.sel-size;
                                    min-width: 0px;
                                    font-size: Theme.fs-small;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    vertical-alignment: top;
                                }
                                // 自动计算模式（设置开启）：选中即后台统计，无按钮，期间显示计算中
                                if AppState.sel-is-dir && AppState.sel-size == "—" && AppState.set-calc-size: Text {
                                    text: AppState.sel-size-calculating ? "计算中…" : "—";
                                    min-width: 0px;
                                    font-size: Theme.fs-small;
                                    color: Theme.muted;
                                    horizontal-stretch: 1;
                                    vertical-alignment: top;
                                }
                                // 手动模式：文件夹且尚未计算时显示「计算」按钮（文字与边框用主题色）
                                if AppState.sel-is-dir && AppState.sel-size == "—" && !AppState.set-calc-size: Rectangle {
                                    width: calc-btn.preferred-width;
                                    height: 24px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.primary;
                                    background: calc-touch.has-hover ? Theme.primary.with-alpha(0.12) : transparent;
                                    calc-btn := HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        Text {
                                            text: AppState.sel-size-calculating ? "计算中…" : "计算";
                                            font-size: Theme.fs-small;
                                            color: Theme.primary;
                                            vertical-alignment: center;
                                        }
                                    }
                                    calc-touch := TouchArea {
                                        enabled: !AppState.sel-size-calculating;
                                        mouse-cursor: calc-touch.enabled ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => { AppState.calculate-folder-size(); }
                                    }
                                }
                            }
                            info-row { label: "修改时间"; value: AppState.sel-modified; }
                            info-row { label: "属性"; value: AppState.sel-attributes; }
                            // 打开方式仅文件（非目录）有意义，目录时为空则不占行
                            if !AppState.sel-is-dir && AppState.sel-open-with != "": info-row {
                                label: "打开方式"; value: AppState.sel-open-with;
                            }
                            // 标签：所选文件已打的内置/自定义标签命色标记（始终显示此行以保持一致性）
                            info-row {
                                label: "标签";
                                value: {
                                    if AppState.sel-tag-important && AppState.sel-tag-archive && AppState.sel-tag-done {
                                        "重要, 待归档, 已完成"
                                    } else if AppState.sel-tag-important && AppState.sel-tag-archive {
                                        "重要, 待归档"
                                    } else if AppState.sel-tag-important && AppState.sel-tag-done {
                                        "重要, 已完成"
                                    } else if AppState.sel-tag-archive && AppState.sel-tag-done {
                                        "待归档, 已完成"
                                    } else if AppState.sel-tag-important {
                                        "重要"
                                    } else if AppState.sel-tag-archive {
                                        "待归档"
                                    } else if AppState.sel-tag-done {
                                        "已完成"
                                    } else {
                                        "未标记"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

