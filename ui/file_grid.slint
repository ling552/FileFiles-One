import { Theme } from "theme.slint";
import { AppState, FileEntry } from "globals.slint";
import { FileIcon } from "file_icon.slint";
import { RenameEdit } from "rename_edit.slint";
import { InputOverlay } from "input_overlay.slint";
import { ListView } from "std-widgets.slint";

// 网格视图（中/大图标），对照 design_ref 的 .file-grid
// 外层加与列表一致的卡片边框，内部缩小留白
// 使用 ListView 按“行”虚拟化：仅渲染可见行的卡片，大目录下保持流畅
export component FileGrid inherits Rectangle {
    callback request-context-menu(int, length, length);
    // 是否绘制卡片外框：单面板视图为 true；双面板内嵌时为 false（由面板卡片提供外框）
    in property <bool> framed: true;
    border-radius: root.framed ? 12px : 0px;
    border-width: root.framed ? 1px : 0px;
    border-color: Theme.border;
    background: root.framed ? Theme.surface.with-alpha(Theme.panel-alpha) : transparent;
    clip: true;

    // 宽度随图标缩放；高度至少容纳上下边距、图标、名称和信息行。
    property <length> cell-w: 112px * AppState.icon-scale;
    property <length> icon-box: 58px * AppState.icon-scale;
    property <length> icon-top: 12px;
    property <length> name-gap: 0px;
    property <length> info-h: 16px;
    // 未选中项最多显示两行；选中项按完整文本高度展开。
    property <length> name-h: 32px;
    property <length> cell-h: max(root.cell-w, root.icon-top + root.icon-box + root.name-gap + root.name-h + root.info-h + 10px);
    property <length> pitch: root.cell-w + 10px;
    // 每行高度（卡片 + 行间距 10px），用于 ListView 行高与命中换算。
    // 选中长名称通过列表上方的独立覆盖层展示，不改变行虚拟化高度。
    property <length> row-h: root.cell-h + 10px;
    // 自适应列数（依据可视宽度）
    property <int> cols: max(1, floor((list.visible-width - 24px) / root.pitch));
    property <int> rows: ceil(AppState.entries.length / max(1, root.cols));

    // 滚动重置：导航新目录时归零 viewport-y，避免停留在上次的滚动位置
    property <int> scroll-token: AppState.scroll-top-token;
    changed scroll-token => { list.viewport-y = 0px; }

    list := ListView {
        // 顶部 12px 留白由 ListView 整体下移提供（而非首行 padding-top）：
        // 首行 padding 会吃掉行间距，导致第一行卡片与第二行粘连（选中底色下尤其明显）
        y: 12px;
        width: 100%;
        height: root.height - 12px;
        // 整数即为合法 model：迭代 0..rows，ListView 仅实例化可见行
        for r in root.rows: Rectangle {
            height: root.row-h;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: start;

                for col in root.cols: cell := Rectangle {
                    // 扁平索引
                    property <int> idx: r * root.cols + col;
                    property <bool> valid: self.idx < AppState.entries.length;
                    width: root.cell-w;
                    height: root.cell-h;

                    if cell.valid: card := Rectangle {
                        property <FileEntry> entry: AppState.entries[cell.idx];
                        // 长名称展示改由顶层覆盖层处理，避免遮住下一行。
                        property <length> extra-name-h: 0px;
                        border-radius: Theme.radius-card;
                        border-width: 1px;
                        border-color: card.entry.selected ? Theme.selection-border : transparent;
                        background: card.entry.selected
                            ? Theme.selection-bg
                            : (ov.hover-idx == cell.idx ? Theme.primary-hover : transparent);
                        // 选中状态（含编辑中）由顶层完整卡片绘制，确保长名称始终在下一行项目之上。
                        visible: !card.entry.selected;
                        drop-shadow-blur: card.entry.selected ? Theme.selection-shadow-blur : 0px;
                        drop-shadow-color: card.entry.selected ? Theme.selection-shadow : transparent;
                        drop-shadow-offset-y: card.entry.selected ? 2px : 0px;
                        // 卡片固定贴住单元格上边缘。
                        x: 0px;
                        y: 0px;
                        width: 100%;
                        height: root.cell-h + card.extra-name-h;
                        clip: true;

                        // 直接定位图标、名称和信息行，避免布局在名称高度变化时重新居中。
                        FileIcon {
                            x: (parent.width - root.icon-box) / 2;
                            y: root.icon-top;
                            icon-class: card.entry.icon-class;
                            label: card.entry.icon-label;
                            thumb: card.entry.thumb;
                            has-thumb: card.entry.has-thumb;
                            has-files: card.entry.has-files;
                            box: root.icon-box;
                        }
                        if AppState.editing-index != cell.idx: name-area := Rectangle {
                            x: 8px;
                            y: root.icon-top + root.icon-box + root.name-gap;
                            width: parent.width - 16px;
                            // 基础卡片始终只显示两行名称；选中后的完整名称由顶层覆盖层绘制。
                            height: root.name-h;
                            clip: true;
                            cell-name-text := Text {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: self.preferred-height;
                                text: card.entry.name;
                                font-size: Theme.fs-small;
                                color: Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: top;
                                // 文件名换行：用 word-wrap 而非 char-wrap。
                                // char-wrap 在 femtovg 渲染器下对 CJK 字符处理异常
                                // （CJK 字符消失、仅残留 ASCII 尾部，如「hey小可爱.txt」显示成「xt」）。
                                // word-wrap 走 unicode-linebreak（UAX 14），CJK 字符间天然为断行点，
                                // 行为等价于逐字换行且对所有渲染器稳定。
                                wrap: word-wrap;
                                overflow: clip;
                            }
                        }
                        // 重命名输入框不再在基础卡内渲染：长名会被卡片 clip 截断。
                        // 改由顶层覆盖层（下方 for entry[i] editing-card）按文本宽度伸长绘制。
                        Text {
                            x: 8px;
                            y: root.icon-top + root.icon-box + root.name-gap + root.name-h + card.extra-name-h;
                            width: parent.width - 16px;
                            // 驱动器显示总容量、便携设备显示类型；其余目录显示修改日期、文件显示大小
                            text: card.entry.icon-class == "drive" ? card.entry.size
                                : card.entry.icon-class == "device" ? card.entry.kind
                                : card.entry.is-dir ? card.entry.modified : card.entry.size;
                            font-size: Theme.fs-tiny;
                            color: Theme.subtle;
                            height: root.info-h;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        // 标签彩色点：叠在图标左下角（重要红 / 待归档橙 / 已完成绿，可并列多个）
                        Rectangle {
                            width: 32px;
                            height: 10px;
                            x: parent.width / 2 - root.icon-box / 2;
                            y: root.icon-top + root.icon-box - 9px;
                            HorizontalLayout {
                                alignment: start;
                                spacing: 3px;
                                if card.entry.tag-important: Rectangle {
                                    width: 9px; height: 9px; border-radius: 4.5px;
                                    background: #d13438; border-width: 2px; border-color: white;
                                }
                                if card.entry.tag-archive: Rectangle {
                                    width: 9px; height: 9px; border-radius: 4.5px;
                                    background: #ff8c00; border-width: 2px; border-color: white;
                                }
                                if card.entry.tag-done: Rectangle {
                                    width: 9px; height: 9px; border-radius: 4.5px;
                                    background: #107c10; border-width: 2px; border-color: white;
                                }
                            }
                        }

                        // Git 状态徽章：图标右下角（M 已修改橙 / ? 未追踪灰 / A 已暂存绿 / ! 冲突红）
                        if card.entry.git-status != "": Rectangle {
                            width: 18px;
                            height: 18px;
                            x: parent.width / 2 + root.icon-box / 2 - 15px;
                            y: root.icon-top + root.icon-box - 15px;
                            border-radius: 5px;
                            border-width: 2px;
                            border-color: white;
                            background: card.entry.git-status == "?" ? #8a99aa
                                : card.entry.git-status == "!" ? #d13438
                                : card.entry.git-status == "A" ? #107c10
                                : #ff8c00;
                            Text {
                                text: card.entry.git-status;
                                color: white;
                                font-size: 11px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }

    // 选中项目作为完整不透明卡片绘制在列表上层：长名称覆盖下一行，
    // 不会再被下一行图标盖住，也不会透出零碎的底层内容。
    for entry[i] in AppState.entries: selected-card := Rectangle {
        property <bool> visible-card: entry.selected;
        property <int> grid-row: floor(i / root.cols);
        property <int> grid-col: mod(i, root.cols);
        property <length> content-y: 12px + self.grid-row * root.row-h + list.viewport-y;
        visible: self.visible-card;
        x: 12px + self.grid-col * root.pitch;
        y: self.content-y;
        width: root.cell-w;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.selection-border;
        // 选中卡片须为实色，才能彻底遮住下方行的图标与文字。
        background: Theme.selection-bg;
        clip: true;
        drop-shadow-blur: Theme.selection-shadow-blur;
        drop-shadow-color: Theme.selection-shadow;
        drop-shadow-offset-y: 2px;

        FileIcon {
            x: (parent.width - root.icon-box) / 2;
            y: root.icon-top;
            icon-class: entry.icon-class;
            label: entry.icon-label;
            thumb: entry.thumb;
            has-thumb: entry.has-thumb;
            has-files: entry.has-files;
            box: root.icon-box;
        }
        selected-name-text := Text {
            visible: AppState.editing-index != i;
            x: 8px;
            y: root.icon-top + root.icon-box + root.name-gap;
            width: parent.width - 16px;
            height: selected-card.expand-name ? self.preferred-height : root.name-h;
            text: entry.name;
            font-size: Theme.fs-small;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: top;
            wrap: word-wrap;
            overflow: clip;
        }
        // 多选时不展开完整名称/不向下延伸：选中卡片统一保持两行裁切的固定高度，
        // 仅单选时展开完整名称（避免框选一大片时卡片高低不齐、互相遮盖）
        property <bool> expand-name: AppState.selected-count == 1;
        // 信息行固定在默认名称区下方；仅单选且名称超两行时才把它向下推。
        property <length> extra-name-h: self.expand-name
            ? max(0px, selected-name-text.preferred-height - root.name-h) : 0px;
        Text {
            x: 8px;
            y: root.icon-top + root.icon-box + root.name-gap + root.name-h + selected-card.extra-name-h;
            width: parent.width - 16px;
            text: entry.icon-class == "drive" ? entry.size
                : entry.icon-class == "device" ? entry.kind
                : entry.is-dir ? entry.modified : entry.size;
            font-size: Theme.fs-tiny;
            color: Theme.subtle;
            height: root.info-h;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        height: root.cell-h + self.extra-name-h;

        // 标签彩色点保持与普通卡片一致。
        Rectangle {
            width: 32px;
            height: 10px;
            x: parent.width / 2 - root.icon-box / 2;
            y: root.icon-top + root.icon-box - 9px;
            HorizontalLayout {
                alignment: start;
                spacing: 3px;
                if entry.tag-important: Rectangle {
                    width: 9px; height: 9px; border-radius: 4.5px;
                    background: #d13438; border-width: 2px; border-color: Theme.selection-bg;
                }
                if entry.tag-archive: Rectangle {
                    width: 9px; height: 9px; border-radius: 4.5px;
                    background: #ff8c00; border-width: 2px; border-color: Theme.selection-bg;
                }
                if entry.tag-done: Rectangle {
                    width: 9px; height: 9px; border-radius: 4.5px;
                    background: #107c10; border-width: 2px; border-color: Theme.selection-bg;
                }
            }
        }
        if entry.git-status != "": Rectangle {
            width: 18px;
            height: 18px;
            x: parent.width / 2 + root.icon-box / 2 - 15px;
            y: root.icon-top + root.icon-box - 15px;
            border-radius: 5px;
            border-width: 2px;
            border-color: Theme.selection-bg;
            background: entry.git-status == "?" ? #8a99aa
                : entry.git-status == "!" ? #d13438
                : entry.git-status == "A" ? #107c10
                : #ff8c00;
            Text {
                text: entry.git-status;
                color: white;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // 统一输入层：网格模式（二维命中），覆盖在 ListView 之上集中处理指针交互
    ov := InputOverlay {
        width: 100%;
        height: 100%;
        pane: "left";
        mode: "grid";
        count: AppState.entries.length;
        cols: root.cols;
        row-h: root.row-h;
        cell-w: root.cell-w;
        pitch-x: root.pitch;
        top-pad: 12px;
        left-pad: 12px;
        // 单击重命名仅识别名称区域（图标下方）
        zone-y: root.icon-top + root.icon-box;
        vp-y <=> list.viewport-y;
        vp-h: list.viewport-height;
        vis-h: list.visible-height;
        request-context-menu(i, mx, my) => { root.request-context-menu(i, mx, my); }
    }

    // 重命名覆盖层：声明在 InputOverlay 之后，使输入框位于输入层之上。
    // 点击框内由 TextInput 接收（光标落到点击位置，可拖选/双击选词）；
    // 点击框外才落到 InputOverlay，提交当前编辑并正常选中。
    // （此前声明在 InputOverlay 之前，输入层拦截一切点击：无论点不点命名区域都会完成重命名。）
    // 独立于 ListView 虚拟化与卡片 clip，长名按名区宽度换行后向下伸长，完整可见；
    // 超出可视区由 FileGrid 的 clip 裁剪。
    for entry[i] in AppState.entries: editing-card := Rectangle {
        property <int> grid-row: floor(i / root.cols);
        property <int> grid-col: mod(i, root.cols);
        property <length> content-y: 12px + self.grid-row * root.row-h + list.viewport-y;
        // 与基础卡片名区逐像素对齐（卡片左缘 + 8px 内缩，宽度 cell-w - 16px），
        // 使编辑态的换行位置与正常显示完全一致，每行字符数相同。
        x: 12px + self.grid-col * root.pitch + 8px;
        y: self.content-y + root.icon-top + root.icon-box + root.name-gap;
        width: root.cell-w - 16px;
        // 定位容器本身不绘制，高度取 0；输入框按文本高度自行向下伸长（无 clip，正常可见）。
        height: 0px;
        // 必须用条件实例化而非 visible 复用实例：复用时退出编辑会多渲染一帧
        // 「非编辑外观」（透明底 + 普通文字色叠在选中底色上），表现为洗白的中间态。
        if AppState.editing-index == i: RenameEdit {
            x: 0px;
            y: 0px;
            width: parent.width;
            multiline: true;   // 网格模式允许按名称区宽度换行
            text: entry.name;
            font-size: Theme.fs-small;
            // 文本变化时保存到全局（供点击外部区域时提交）
            text-changed(t) => { AppState.rename-text = t; }
            // 按 Escape 退出重命名
            cancel => { AppState.editing-index = -1; }
            commit(t) => {
                AppState.rename-entry(i, t);
                AppState.editing-index = -1;
            }
        }
    }
}
