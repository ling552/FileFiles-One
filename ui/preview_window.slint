// 独立预览窗口（空格 Quick Look）：与主窗口分离的真实操作系统窗口。
//
// 为什么独立成窗口：预览不再遮挡文件列表，可与主窗口并排比对，也能自由缩放；
// 视频（Media Foundation）与网页（WebView2）原生子窗口改挂到本窗口，
// 由 Rust 侧按本窗口客户区（扣除头部/底部）计算矩形对齐。
//
// 注意：Slint 的 global 是「每根组件实例一份」，本窗口无法共享主窗口的 AppState，
// 故单独定义 PreviewState，由 Rust 在打开时把内容与主题一并推送过来。

import { Theme } from "theme.slint";
import { FileIcon } from "file_icon.slint";
import { ScrollView } from "std-widgets.slint";

// 归档树的单个可见节点（压缩包预览用）
export struct ArchiveNode {
    name: string,          // 仅本级名称
    full-path: string,     // 归档内完整路径（展开状态的稳定键）
    size: string,          // 已格式化的大小文本
    is-dir: bool,
    level: int,            // 缩进层级，根级 0
    expanded: bool,        // 目录是否展开
    has-children: bool,    // 目录是否含子项（决定是否画箭头）
}

// 加载动画：圆环沿圆周双向扫动，4 秒一循环 ——
// 正向画满（0→一整圈）→正向擦除（满→0）→反向画满→反向擦除，如此往复。
//
// 端点圆角交给 stroke-line-cap: round（端点圆帽由描边渲染器生成），不再自绘
// 端点圆点：手绘圆点要按 viewbox→像素手工换算定位，只要与实际贴合映射（含
// 居中偏移与 DPI 缩放）有一点出入，端点就会溢出圆环或整体偏移，看起来"不圆"。
//
// 弧长范围取 [0.04, 0.998] 而非 [0, 1]：0 会缩成看不见的点；1.0 是完整圆周，
// 而 femtovg 后端填充整圆有缺陷（Slint 官方 SpinnerBase 同样以 0.9999 上限规避），
// 到整圈时弧线会变形/消失。两端各留余量后，弧段始终落在同一圆周上，恒为正圆。
// 不用 std-widgets 的 Spinner：它的描边固定为 Fluent 蓝，无法跟随本程序主题色。
component LoadingRing inherits Rectangle {
    in property <length> ring-size: 34px;
    in property <brush> ring-stroke: Theme.primary;
    width: root.ring-size;
    height: root.ring-size;

    // 循环相位：0 正向画 / 1 正向擦 / 2 反向画 / 3 反向擦
    property <float> cyc: mod(animation-tick(), 4s) / 4s;
    property <float> ph: floor(self.cyc * 4.0);
    property <float> fr: self.cyc * 4.0 - self.ph;
    property <bool> grow: mod(self.ph, 2.0) < 1.0;
    property <float> raw: self.grow ? self.fr : 1.0 - self.fr;
    property <float> len: 0.04 + self.raw * 0.958;
    property <float> dir: self.ph < 1.5 ? 1.0 : -1.0;
    // 扫动头匀速 1 圈/秒；尾 = 头 − 方向×弧长（方向切换时弧长最短，无跳变）
    property <angle> head-a: self.cyc * 1440deg;
    property <angle> tail-a: self.head-a - self.dir * self.len * 360deg;

    Path {
        // 元素与 viewbox 同为正方形：等比贴合后圆心落在元素中心，弧线不会被拉成椭圆
        width: root.ring-size;
        height: root.ring-size;
        viewbox-width: 100;
        viewbox-height: 100;
        fit: contain;
        stroke: root.ring-stroke;
        stroke-width: 8px;
        stroke-line-cap: round;
        MoveTo {
            x: 50 + 42 * sin(root.tail-a);
            y: 50 - 42 * cos(root.tail-a);
        }
        ArcTo {
            radius-x: 42;
            radius-y: 42;
            x: 50 + 42 * sin(root.head-a);
            y: 50 - 42 * cos(root.head-a);
            sweep: root.dir > 0.0;
            large-arc: root.len > 0.5;
        }
    }
}

// 加载占位：旋转环 + 说明文字，居中于内容区
component LoadingOverlay inherits Rectangle {
    in property <string> label;
    in property <bool> on-dark: false;
    VerticalLayout {
        alignment: center;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            LoadingRing {
                ring-stroke: root.on-dark ? #ffffffcc : Theme.primary;
            }
        }
        Text {
            width: 100%;
            text: root.label;
            font-size: Theme.fs-body;
            color: root.on-dark ? #9aa7b5 : Theme.muted;
            horizontal-alignment: center;
        }
    }
}

export global PreviewState {
    // 内容类型：0 信息 / 1 图片 / 2 文本 / 3 文件夹 / 4 视频 / 5 归档树 / 6 音频
    in-out property <int> kind;
    // 内容仍在后台加载（图片解码 / 视频媒体源解析）：显示加载动画。
    // 窗口尺寸在显示前已按内容真实尺寸算好，加载完成只换内容不改窗口。
    in-out property <bool> loading: false;
    in-out property <string> name;
    in-out property <string> subtitle;
    in-out property <image> preview-image;
    in-out property <bool> has-image;
    in-out property <int> img-w: 0;
    in-out property <int> img-h: 0;
    // 文本预览的四层等宽叠加（正文 + 关键字/字符串/注释染色层）
    in-out property <string> text-content;
    in-out property <string> code-kw;
    in-out property <string> code-str;
    in-out property <string> code-cmt;
    in-out property <string> info;
    in-out property <string> icon-class;
    in-out property <image> thumb;
    in-out property <bool> has-thumb: false;
    // Markdown/HTML/PHP 的「渲染 ↔ 源码」双视图
    // （Office 文档走本机 Office 高保真渲染，不显示此切换）
    in-out property <bool> can-render: false;
    in-out property <bool> web-mode: false;
    // Office 文档恒为真：隐藏渲染/源码切换；pending 为真时渲染区显示加载条
    in-out property <bool> office-doc: false;
    in-out property <bool> office-pending: false;
    callback set-web-mode(bool);
    // 切换视频无边框全屏（仅 kind==4 视频显示，音频不显示全屏按钮）
    callback toggle-fullscreen();
    // 视频是否处于全屏（按钮图标切换用）
    in-out property <bool> video-fullscreen: false;
    // 音频播放状态（kind==6 时 Slint 自绘控制条用，由 Rust 定时推送）。
    // 音频无原生子窗口，播放/暂停/进度/速率全部走 Slint 控件。
    in-out property <int> audio-position: 0;
    in-out property <int> audio-duration: 0;
    in-out property <string> audio-pos-text: "00:00";
    in-out property <string> audio-dur-text: "00:00";
    in-out property <bool> audio-paused: false;
    in-out property <bool> audio-muted: false;
    in-out property <float> audio-rate: 1.0;
    callback audio-toggle-play();
    callback audio-seek(float);
    callback audio-set-rate(float);
    callback audio-toggle-mute();
    callback audio-replay();
    // 归档树：仅包含当前应显示的节点（父目录折叠时其后代由 Rust 过滤掉）
    in-out property <[ArchiveNode]> archive-nodes;
    // 切换第 idx 个节点的展开/折叠（Rust 侧维护展开集合并重算可见节点）
    callback toggle-folder(int);
    // 关闭预览（Esc / 空格 / 头部关闭按钮 / 窗口 X）
    callback close-preview();
}

export component PreviewWindow inherits Window {
    title: PreviewState.name == "" ? "预览" : "预览 - " + PreviewState.name;
    preferred-width: 860px;
    preferred-height: 640px;
    // 竖屏视频窗口偏窄（如 382px 内容宽），下限需容纳竖屏，否则会被钳制出黑边
    min-width: 320px;
    min-height: 320px;
    background: Theme.bg;
    forward-focus: keys;

    // 空格 / Esc 关闭，与主窗口的 Quick Look 手感一致
    keys := FocusScope {
        key-pressed(ev) => {
            if (ev.text == " " || ev.text == Key.Escape) {
                PreviewState.close-preview();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // ── 头部：图标 + 名称/副标题 + 视图切换 ──
            Rectangle {
                height: 60px;
                background: Theme.surface;
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 14px;
                    padding-right: 12px;
                    spacing: 12px;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - 40px) / 2;
                        FileIcon {
                            icon-class: PreviewState.icon-class;
                            thumb: PreviewState.thumb;
                            has-thumb: PreviewState.has-thumb;
                            box: 40px;
                            radius: 9px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: PreviewState.name;
                            font-size: 15px;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: PreviewState.subtitle;
                            font-size: Theme.fs-small;
                            color: Theme.muted;
                            overflow: elide;
                        }
                    }
                    // 渲染 / 源码切换（仅 Markdown/HTML/PHP；Office 高保真渲染不显示）
                    if PreviewState.can-render && !PreviewState.office-doc: Rectangle {
                        width: 116px;
                        height: 30px;
                        y: (parent.height - 30px) / 2;
                        border-radius: 8px;
                        background: Theme.surface-2;
                        border-width: 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding: 2px;
                            spacing: 2px;
                            Rectangle {
                                border-radius: 6px;
                                background: PreviewState.web-mode ? Theme.primary-soft : (render-btn.has-hover ? Theme.primary-hover : transparent);
                                Text {
                                    text: "渲染";
                                    font-size: Theme.fs-tiny;
                                    color: PreviewState.web-mode ? Theme.primary : Theme.muted;
                                    font-weight: PreviewState.web-mode ? 700 : 400;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                render-btn := TouchArea { clicked => { PreviewState.set-web-mode(true); } }
                            }
                            Rectangle {
                                border-radius: 6px;
                                background: !PreviewState.web-mode ? Theme.primary-soft : (source-btn.has-hover ? Theme.primary-hover : transparent);
                                Text {
                                    text: "源码";
                                    font-size: Theme.fs-tiny;
                                    color: !PreviewState.web-mode ? Theme.primary : Theme.muted;
                                    font-weight: !PreviewState.web-mode ? 700 : 400;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                source-btn := TouchArea { clicked => { PreviewState.set-web-mode(false); } }
                            }
                        }
                    }
                    // 全屏按钮（仅视频预览显示，音频无需全屏）。
                    // 头部不再放关闭按钮：本窗口有系统标题栏，其 X 已是关闭入口，
                    // 再画一个等于同一功能出现两次。
                    if PreviewState.kind == 4: Rectangle {
                        width: 30px;
                        height: 30px;
                        y: (parent.height - 30px) / 2;
                        border-radius: 8px;
                        background: fsbtn.has-hover ? Theme.primary-hover : transparent;
                        Text {
                            text: PreviewState.video-fullscreen ? "\u{E73F}" : "\u{E740}";
                            font-family: "Segoe MDL2 Assets";
                            font-size: 13px;
                            color: fsbtn.has-hover ? Theme.primary : Theme.muted;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        fsbtn := TouchArea { clicked => { PreviewState.toggle-fullscreen(); } }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            }

            // ── 内容区：原生视频/网页子窗口按本区域矩形对齐覆盖 ──
            Rectangle {
                vertical-stretch: 1;
                background: Theme.surface-2;
                clip: true;

                // 图片（kind == 1）：滚轮缩放、拖动查看
                if PreviewState.kind == 1: img-area := Rectangle {
                    clip: true;
                    // 自适应初始缩放：能放下就 1:1（小图不放大），放不下缩到刚好容纳
                    property <float> fit-zoom: min(1.0, min(
                        self.width / max(1px, PreviewState.img-w * 1px),
                        self.height / max(1px, PreviewState.img-h * 1px)));
                    property <float> user-zoom: 0;
                    property <float> zoom: img-area.user-zoom > 0 ? img-area.user-zoom : img-area.fit-zoom;
                    property <length> off-x: 0px;
                    property <length> off-y: 0px;
                    property <length> max-off-x: max(0px, (PreviewState.img-w * 1px * img-area.zoom - self.width) / 2);
                    property <length> max-off-y: max(0px, (PreviewState.img-h * 1px * img-area.zoom - self.height) / 2);
                    // 切换到另一张图片时重置缩放与偏移
                    property <string> cur-img: PreviewState.name;
                    changed cur-img => { self.user-zoom = 0; self.off-x = 0px; self.off-y = 0px; }

                    if PreviewState.has-image: Image {
                        x: (img-area.width - self.width) / 2 + clamp(img-area.off-x, -img-area.max-off-x, img-area.max-off-x);
                        y: (img-area.height - self.height) / 2 + clamp(img-area.off-y, -img-area.max-off-y, img-area.max-off-y);
                        width: max(1px, PreviewState.img-w * 1px * img-area.zoom);
                        height: max(1px, PreviewState.img-h * 1px * img-area.zoom);
                        source: PreviewState.preview-image;
                        image-fit: fill;
                    }
                    // 位图解码在后台线程进行，期间显示加载动画（窗口已是最终尺寸）
                    if !PreviewState.has-image: LoadingOverlay {
                        label: PreviewState.loading ? "正在加载图片…" : "无法生成预览";
                    }
                    if PreviewState.has-image: TouchArea {
                        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                        property <length> press-off-x: 0px;
                        property <length> press-off-y: 0px;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                self.press-off-x = img-area.off-x;
                                self.press-off-y = img-area.off-y;
                            }
                        }
                        moved => {
                            img-area.off-x = clamp(self.press-off-x + (self.mouse-x - self.pressed-x), -img-area.max-off-x, img-area.max-off-x);
                            img-area.off-y = clamp(self.press-off-y + (self.mouse-y - self.pressed-y), -img-area.max-off-y, img-area.max-off-y);
                        }
                        scroll-event(ev) => {
                            img-area.user-zoom = clamp(img-area.zoom * (ev.delta-y > 0 ? 1.15 : 1 / 1.15), 0.05, 8.0);
                            return accept;
                        }
                    }
                    if PreviewState.has-image: Rectangle {
                        x: parent.width - self.width - 10px;
                        y: 10px;
                        width: zoom-label.preferred-width + 16px;
                        height: 24px;
                        border-radius: 7px;
                        background: #00000066;
                        zoom-label := Text {
                            width: 100%;
                            height: 100%;
                            text: round(img-area.zoom * 100) + "%";
                            color: white;
                            font-size: Theme.fs-tiny;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // 网页渲染视图（kind == 2 且渲染模式）：WebView2 子窗口覆盖本区域
                // Office 转换中显示加载条（不定期的文本内容不再先闪一下）
                if PreviewState.kind == 2 && PreviewState.web-mode: Rectangle {
                    background: white;
                    if PreviewState.office-doc && PreviewState.office-pending: LoadingOverlay {
                        label: "正在通过 Office 生成高保真预览…";
                    }
                    if !PreviewState.office-doc || !PreviewState.office-pending: LoadingOverlay {
                        label: "正在加载渲染视图…";
                    }
                }

                // 文本/代码（kind == 2 源码模式）：四层等宽 Text 字符对齐叠加实现多色高亮
                if PreviewState.kind == 2 && !PreviewState.web-mode: ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        Rectangle {
                            height: code-base.preferred-height;
                            code-base := Text {
                                x: 0; y: 0; width: parent.width;
                                text: PreviewState.text-content;
                                font-size: Theme.fs-small;
                                font-family: "Consolas";
                                color: Theme.text;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                            }
                            Text {
                                x: 0; y: 0; width: parent.width;
                                text: PreviewState.code-kw;
                                font-size: Theme.fs-small;
                                font-family: "Consolas";
                                color: Theme.dark ? #6aa9ff : #005fb0;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                            }
                            Text {
                                x: 0; y: 0; width: parent.width;
                                text: PreviewState.code-str;
                                font-size: Theme.fs-small;
                                font-family: "Consolas";
                                color: Theme.dark ? #e0a06a : #b06a1f;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                            }
                            Text {
                                x: 0; y: 0; width: parent.width;
                                text: PreviewState.code-cmt;
                                font-size: Theme.fs-small;
                                font-family: "Consolas";
                                color: Theme.muted;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                            }
                        }
                    }
                }

                // 视频（kind == 4）：黑底衬托，画面与控制栏由原生子窗口覆盖绘制。
                // 媒体源解析完成前原生子窗口保持隐藏，此处加载动画可见。
                if PreviewState.kind == 4: Rectangle {
                    background: black;
                    if PreviewState.loading: LoadingOverlay {
                        label: "正在加载视频…";
                        on-dark: true;
                    }
                }

                // 音频（kind == 6）：Slint 自绘播放器（无原生子窗口）。
                // 上方封面：内嵌封面（lofty 提取）优先，否则文件列表图标（通用音频图标）；
                // 下方播放/暂停 + 进度轨道（点击/拖动跳转）+ 速率调节 + 音量。
                if PreviewState.kind == 6: Rectangle {
                    background: Theme.surface-2;
                    VerticalLayout {
                        padding: 16px;
                        padding-top: 12px;
                        padding-bottom: 12px;
                        spacing: 10px;
                        alignment: center;
                        // 封面卡片：220×220 圆角，封面或通用音频图标
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 220px;
                                height: 220px;
                                border-radius: 16px;
                                background: Theme.surface.with-alpha(0.8);
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;
                                if PreviewState.has-thumb: Image {
                                    width: 100%;
                                    height: 100%;
                                    source: PreviewState.thumb;
                                    image-fit: cover;
                                }
                                // 无缩略图时用通用音频文件图标（与截图中的白底播放页一致），
                                // 而非音符占位，保证无封面时仍是熟悉的音频图标。
                                if !PreviewState.has-thumb: FileIcon {
                                    icon-class: PreviewState.icon-class == "" ? "audio" : PreviewState.icon-class;
                                    box: 120px;
                                    radius: 22px;
                                    x: (parent.width - 120px) / 2;
                                    y: (parent.height - 120px) / 2;
                                }
                            }
                        }
                        // 进度行：当前时间 + 轨道（点击/拖动跳转）+ 总时长
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: PreviewState.audio-pos-text;
                                font-size: Theme.fs-tiny;
                                color: Theme.muted;
                                vertical-alignment: center;
                                min-width: 44px;
                                horizontal-alignment: right;
                            }
                            track := Rectangle {
                                horizontal-stretch: 1;
                                height: 22px;
                                property <float> ratio: PreviewState.audio-duration > 0
                                    ? clamp(PreviewState.audio-position * 1.0 / max(1, PreviewState.audio-duration), 0.0, 1.0)
                                    : 0.0;
                                // 底轨：从最左端铺到最右端
                                Rectangle {
                                    x: 0;
                                    width: 100%;
                                    height: 6px;
                                    y: (parent.height - 6px) / 2;
                                    border-radius: 3px;
                                    background: Theme.border;
                                }
                                // 已播部分：固定从 0 开始向右延伸到当前进度
                                Rectangle {
                                    x: 0;
                                    width: track.width * track.ratio;
                                    height: 6px;
                                    y: (parent.height - 6px) / 2;
                                    border-radius: 3px;
                                    background: Theme.primary;
                                }
                                // 滑块：圆心落已播末端，钳制不超出轨道两端
                                Rectangle {
                                    width: 12px;
                                    height: 12px;
                                    x: clamp(track.width * track.ratio - 6px, -6px, track.width - 6px);
                                    y: (parent.height - 12px) / 2;
                                    border-radius: 6px;
                                    background: Theme.primary;
                                    border-width: 2px;
                                    border-color: white;
                                }
                                track-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => {
                                        PreviewState.audio-seek(clamp(self.mouse-x * 1.0 / max(1px, track.width), 0.0, 1.0));
                                    }
                                    moved => {
                                        if self.pressed {
                                            PreviewState.audio-seek(clamp(self.mouse-x * 1.0 / max(1px, track.width), 0.0, 1.0));
                                        }
                                    }
                                }
                            }
                            Text {
                                text: PreviewState.audio-dur-text;
                                font-size: Theme.fs-tiny;
                                color: Theme.muted;
                                vertical-alignment: center;
                                min-width: 44px;
                            }
                        }
                        // 控制行：重播 + 播放/暂停（大圆钮）+ 静音。
                        // 两侧 36px 按钮需垂直居中，否则在 52px 行内默认顶对齐而上飘。
                        HorizontalLayout {
                            alignment: center;
                            spacing: 18px;
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                y: (parent.height - 36px) / 2;
                                border-radius: 18px;
                                background: replay-ta.has-hover ? Theme.primary-hover : transparent;
                                Text {
                                    text: "\u{E72C}";
                                    font-family: "Segoe MDL2 Assets";
                                    font-size: 15px;
                                    color: replay-ta.has-hover ? Theme.primary : Theme.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                replay-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { PreviewState.audio-replay(); }
                                }
                            }
                            Rectangle {
                                width: 52px;
                                height: 52px;
                                border-radius: 26px;
                                background: Theme.primary;
                                Text {
                                    text: PreviewState.audio-paused ? "\u{E768}" : "\u{E769}";
                                    font-family: "Segoe MDL2 Assets";
                                    font-size: 20px;
                                    color: white;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                play-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { PreviewState.audio-toggle-play(); }
                                }
                            }
                            Rectangle {
                                width: 36px;
                                height: 36px;
                                y: (parent.height - 36px) / 2;
                                border-radius: 18px;
                                background: mute-ta.has-hover ? Theme.primary-hover : transparent;
                                Text {
                                    text: PreviewState.audio-muted ? "\u{E74F}" : "\u{E767}";
                                    font-family: "Segoe MDL2 Assets";
                                    font-size: 15px;
                                    color: mute-ta.has-hover ? Theme.primary : Theme.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                mute-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { PreviewState.audio-toggle-mute(); }
                                }
                            }
                        }
                        // 速率行：0.5x / 1.0x / 1.25x / 1.5x / 2.0x
                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: "速率";
                                font-size: Theme.fs-tiny;
                                color: Theme.muted;
                                vertical-alignment: center;
                            }
                            for r[idx] in [0.5, 1.0, 1.25, 1.5, 2.0]: Rectangle {
                                width: 52px;
                                height: 26px;
                                border-radius: 13px;
                                background: PreviewState.audio-rate == r ? Theme.primary-soft : (rate-ta.has-hover ? Theme.primary-hover : transparent);
                                border-width: 1px;
                                border-color: PreviewState.audio-rate == r ? Theme.primary : Theme.border;
                                Text {
                                    text: r == 1.0 ? "1.0x" : r == 0.5 ? "0.5x" : r == 1.25 ? "1.25x" : r == 1.5 ? "1.5x" : "2.0x";
                                    font-size: Theme.fs-tiny;
                                    font-weight: PreviewState.audio-rate == r ? 700 : 400;
                                    color: PreviewState.audio-rate == r ? Theme.primary : Theme.muted;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                rate-ta := TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { PreviewState.audio-set-rate(r); }
                                }
                            }
                        }
                    }
                    if PreviewState.loading: LoadingOverlay {
                        label: "正在加载音频…";
                    }
                }

                // 归档树（kind == 5）：Apple Finder 访达式层级列表
                // 设计要点（apple-design §12/15）：卡片化圆角行、按压即时反馈(§1)、细分隔线、vibrancy 文字
                if PreviewState.kind == 5: Rectangle {
                    // 背景与上层 surface-2 一致，形成统一材质，不再突兀转白
                    background: Theme.surface-2;
                    ScrollView {
                        VerticalLayout {
                            padding: 10px;
                            padding-top: 8px;
                            padding-bottom: 12px;
                            spacing: 3px;
                            for node[idx] in PreviewState.archive-nodes: Rectangle {
                                height: 34px;
                                border-radius: 10px;
                                // 按压态比 hover 更深，符合 §1 pointer-down 即时反馈
                                background: row-ta.pressed ? Theme.primary-pressed
                                    : row-ta.has-hover ? Theme.primary-soft : transparent;
                                animate background { duration: 120ms; easing: ease-out; }
                                HorizontalLayout {
                                    // Apple 访达层级：每级 20px 缩进，右侧留足呼吸空间
                                    padding-left: 12px + node.level * 20px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    // 展开箭头：圆形轻底 + 细箭头，未展开时更淡
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        y: (parent.height - 20px) / 2;
                                        border-radius: 6px;
                                        background: node.has-children
                                            ? (node.expanded ? Theme.primary-soft : (row-ta.has-hover ? Theme.border : transparent))
                                            : transparent;
                                        if node.has-children: Text {
                                            text: node.expanded ? "\u{E70D}" : "\u{E76C}";
                                            font-family: "Segoe MDL2 Assets";
                                            font-size: 8px;
                                            color: node.expanded ? Theme.primary : Theme.subtle;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // 类型图标：Finder 蓝文件夹 / 白底文档，带柔和阴影与描边
                                    FileIcon {
                                        icon-class: node.is-dir ? "folder" : "default";
                                        box: 20px;
                                        radius: 6px;
                                        compact: false;
                                        y: (parent.height - 20px) / 2;
                                    }
                                    Text {
                                        text: node.name;
                                        // Finder 字阶：13px 常规，目录稍重，负 tracking 更紧凑
                                        font-size: Theme.fs-body;
                                        font-weight: node.is-dir ? 600 : 400;
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    // 大小：等宽数字感，淡色右对齐，保持 88px 对齐列
                                    Text {
                                        text: node.size;
                                        font-size: 11px;
                                        color: Theme.subtle;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                        min-width: 88px;
                                    }
                                }
                                row-ta := TouchArea {
                                    mouse-cursor: node.has-children ? MouseCursor.pointer : MouseCursor.default;
                                    clicked => {
                                        if (node.has-children) {
                                            PreviewState.toggle-folder(idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 文件夹（3）/ 其它信息（0）：大图标衬底 + 名称 + 信息行
                if PreviewState.kind == 0 || PreviewState.kind == 3: VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 132px;
                            height: 132px;
                            border-radius: 24px;
                            background: Theme.surface.with-alpha(Theme.dark ? 0.35 : 0.75);
                            border-width: 1px;
                            border-color: Theme.border;
                            FileIcon {
                                icon-class: PreviewState.icon-class;
                                thumb: PreviewState.thumb;
                                has-thumb: PreviewState.has-thumb;
                                box: 96px;
                                radius: 18px;
                                x: (parent.width - 96px) / 2;
                                y: (parent.height - 96px) / 2;
                            }
                        }
                    }
                    Text {
                        width: 100%;
                        text: PreviewState.name;
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        width: 100%;
                        text: PreviewState.info;
                        font-size: Theme.fs-body;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        vertical-stretch: 1;
                    }
                }
            }

            // ── 底部提示栏：原生视频画面亦止于此栏上方 ──
            Rectangle {
                height: 38px;
                background: Theme.surface;
                Rectangle { y: 0; height: 1px; background: Theme.border; }
                Text {
                    text: PreviewState.kind == 1
                        ? "滚轮缩放 · 拖动查看 · 按 空格 或 Esc 关闭"
                        : PreviewState.kind == 5
                            ? "点击文件夹展开 / 折叠 · 按 空格 或 Esc 关闭"
                            : PreviewState.office-doc
                                ? "本机 Office 高保真预览 · 按 空格 或 Esc 关闭"
                                : PreviewState.can-render
                                    ? "渲染视图由本机应用排版 · 可切换源码 · 按 空格 或 Esc 关闭"
                                    : "按 空格 或 Esc 关闭预览";
                    font-size: Theme.fs-tiny;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
